{
  "name": "nhserver",
  "version": "1.0.0",
  "description": "A lightweight, modular, and strongly-typed HTTP server framework for Node.js built with TypeScript.",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node examples/basic_service.ts"
  },
  "keywords": [
    "server",
    "http",
    "rest",
    "framework",
    "typescript"
  ],
  "author": "Juan Andres Jaramillo Garcia",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "vitest": "^5.0.1"
  }
}
